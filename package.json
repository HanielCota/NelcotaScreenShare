{
  "name": "nelcota-screenshare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:fix": "oxlint --config oxlint.config.ts --fix .",
    "lint:fast": "oxlint --config oxlint.fast.config.mjs .",
    "lint:fast:fix": "oxlint --config oxlint.fast.config.mjs --fix .",
    "lint:config": "oxlint --config oxlint.config.ts --print-config",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:bootstrap:dev": "docker compose -f docker-compose.dev.yml up -d --wait",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/migrate.mjs --external:pg-native --log-level=warning --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "build:scripts": "pnpm build:migrate && esbuild scripts/create-owner.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/create-owner.mjs --packages=external --alias:server-only=./node_modules/server-only/empty.js --log-level=warning && esbuild scripts/seed.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/seed.mjs --packages=external --alias:server-only=./node_modules/server-only/empty.js --log-level=warning",
    "admin:create-owner": "pnpm build:scripts && node --env-file-if-exists=.env.local dist/create-owner.mjs",
    "db:seed": "pnpm build:scripts && node --env-file-if-exists=.env.local dist/seed.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@gsap/react": "^2.1.2",
    "@livekit/components-react": "^2.9.24",
    "@node-rs/argon2": "2.2.1",
    "@sentry/nextjs": "11.4.0",
    "@tanstack/react-table": "9.2.6",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "next-safe-action": "8.7.3",
    "nodemailer": "^10.0.15",
    "nuqs": "2.10.1",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pino-pretty": "13.2.0",
    "shadcn": "4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
