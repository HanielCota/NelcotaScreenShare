# Chaves do LiveKit (as mesmas configuradas no livekit.yaml / docker-compose.livekit.yml)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# URL pública do servidor LiveKit (WebSocket). Lida em runtime pelo servidor
# e enviada ao navegador junto com o token — não precisa de rebuild ao mudar.
NEXT_PUBLIC_LIVEKIT_URL=wss://lk.seudominio.com

# Opcional: se definida, exige esta senha para entrar em qualquer sala.
ACCESS_PASSWORD=

# Opcional: limite de participantes por sala (2 a 8). Padrão: 6.
MAX_PARTICIPANTS=6
