# Chaves do LiveKit (as mesmas configuradas no livekit.yaml / docker-compose.livekit.yml)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# URL pública do servidor LiveKit (WebSocket). Lida em runtime pelo servidor
# e enviada ao navegador junto com o token — não precisa de rebuild ao mudar.
NEXT_PUBLIC_LIVEKIT_URL=wss://lk.seudominio.com

# Opcional: se definida (8+ caracteres), exige esta senha para entrar em qualquer sala.
# Cada IP tem 5 tentativas erradas a cada 15 minutos.
ACCESS_PASSWORD=

# Opcional: limite de participantes por sala (2 a 8). Padrão: 6.
MAX_PARTICIPANTS=6

# Opcional: quantos proxies confiáveis ficam na frente do app (padrão 1 = Traefik
# do Coolify). Use 2 se o domínio do app passar também pelo proxy da Cloudflare.
TRUSTED_PROXY_HOPS=1

# Opcional: Postgres para as configurações do /admin (e o que vier depois).
# Use o papel nelcota_app (sem DDL). Migrações são um job separado. Sem ela, valem os padrões.
DATABASE_URL=postgres://usuario:senha@host:5432/nelcota

# Painel /admin (Better Auth). Sem ADMIN_AUTH_SECRET o painel fica desligado.
# Gere com: openssl rand -base64 48
ADMIN_AUTH_SECRET=
# Origem pública do app (links de convite e de redefinição de senha).
APP_URL=http://localhost:3000
# E-mail transacional. Em dev, sem SMTP_URL, os e-mails vão para o log.
# Em produção é obrigatório quando o painel está ligado.
SMTP_URL=
MAIL_FROM="Nelcota <nao-responda@seudominio.com>"

# Só para `pnpm db:migrate` local. Em produção fica nos segredos do CI, NUNCA no app.
MIGRATOR_DATABASE_URL=

# Banco DESCARTÁVEL dos testes de integração (o Vitest recria bancos a partir dele).
TEST_DATABASE_URL=

# Observabilidade (opcionais)
SENTRY_DSN=
LOG_LEVEL=
