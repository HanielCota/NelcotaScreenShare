{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortTailwindcss": {
    "stylesheet": "./app/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    ".next/**",
    "drizzle/meta/**",
    "design/**/*.provenance.json",
    "coverage/**",
    "dist/**"
  ]
}
